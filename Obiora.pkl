      "source": [
        "x = df[['age','sex','resting_bp_systolic','resting_bp_diastolic','cholesterol_total','hdl','ldl','triglycerides','fasting_blood_sugar','family_history','smoker_status','alcohol_units_per_week','exercise_minutes_per_week','sleep_hours','stress_score','wearable_owner','daily_steps','diet_quality_score','has_heart_disease',]]\n",
